{% comment %}
      Purelane homepage hero
      - Hero copy and CTAs are configurable at section level.
      - Offer cards are configurable slide blocks.
      - All schema data is contained in the schema block below.
{% endcomment %}

{%- liquid
  assign heading = section.settings.heading | default: 'Clean<br>That <span>Lasts</span>'
  assign subheading = section.settings.subheading | default: 'Homecare that works on the toughest grime, made from plants. Kind to your home, your family and the world outside it.'
  assign primary_text = section.settings.primary_text | default: 'Shop now'
  assign secondary_text = section.settings.secondary_text | default: 'How it works'
-%}

<section
  id="shopify-section-{{ section.id }}"
  class="pl-section pl-hero-sec pl-hero-sec--{{ section.settings.background_style | default: 'scene1' }}"
  data-section-id="{{ section.id }}">
  {%- if section.settings.show_water_animation -%}
    <div class="pl-hero-water" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
    </div>
  {%- endif -%}

  <div class="pl-wrap pl-hero">
    <div class="pl-hero-copy pl-rv">
      <span class="pl-kicker">Plant-powered homecare</span>
      <div class="pl-d1 pl-hero-heading">{{ heading }}</div>
      <p class="pl-lede">{{ subheading | escape }}</p>

      <div class="pl-hero-actions">
        <a class="pl-btn pl-btn-primary" href="{{ section.settings.primary_link | default: '#shop' }}">
          {{ primary_text | escape }}
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"><path d="M5 12h13m-5-6 6 6-6 6" /></svg>
        </a>
        <a class="pl-btn pl-btn-ghost" href="{{ section.settings.secondary_link | default: '#bundles' }}">
          {{ secondary_text | escape }}
        </a>
      </div>

      <ul class="pl-hero-points" role="list">
        <li>Effective plant-based formulas</li>
        <li>Kind to hands and homes</li>
        <li>Free shipping across India</li>
      </ul>
    </div>

    <div class="pl-hero-offers pl-rv" aria-label="Bundle offers">
      <div class="pl-hero-orb" aria-hidden="true">
        <svg viewBox="0 0 140 140" fill="none"><path
            d="M70 124C70 87 90 59 122 50c0 37-20 65-52 74Z"
            fill="currentColor"
            opacity=".16" /><path
            d="M70 124C70 87 50 59 18 50c0 37 20 65 52 74Z"
            fill="currentColor"
            opacity=".11" /><path
            d="M70 124V35"
            stroke="currentColor"
            stroke-width="2"
            opacity=".38" /></svg>
      </div>

      {%- if section.blocks.size > 0 -%}
        <div class="pl-hero-offer-list">
          {%- for block in section.blocks -%}
            <article class="pl-glass pl-hero-offer" {{ block.shopify_attributes }}>
              <span class="pl-hero-offer-index">0{{ forloop.index }}</span>
              <div>
                <h2>{{ block.settings.label | escape }}</h2>
                <div class="pl-hero-price">
                  <strong>{{ block.settings.price | escape }}</strong>
                  {%- if block.settings.compare_price != blank -%}
                    <s>{{ block.settings.compare_price | escape }}</s>
                  {%- endif -%}
                </div>
              </div>
              {%- if block.settings.discount_text != blank -%}
                <span class="pl-hero-discount">{{ block.settings.discount_text | escape }}</span>
              {%- endif -%}
            </article>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: clamp(42px, 7vw, 90px) 0;
    background: radial-gradient(circle at 84% 22%, rgba(201,118,29,.16), transparent 30%), linear-gradient(135deg, #f5f3ec, #ece6f7);
  }
  section[id="shopify-section-{{ section.id }}"].pl-hero-sec--scene2 {
    background: radial-gradient(circle at 84% 22%, rgba(0,112,106,.18), transparent 30%), linear-gradient(135deg, #eef5ef, #e5eff1);
  }
  #shopify-section-{{ section.id }}
  .pl-hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(280px, 0.9fr);
    align-items: center;
    gap: clamp(30px, 7vw, 100px);
    z-index: 1;
  }
  #shopify-section-{{ section.id }}
  .pl-hero-copy {
    max-width: 660px;
  }
  #shopify-section-{{ section.id }}
  .pl-hero-copy .pl-d1 {
    color: var(--pl-surface);
    margin: 12px 0 18px;
    letter-spacing: -0.055em;
  }
  #shopify-section-{{ section.id }}
  .pl-hero-copy .pl-d1 span {
    color: var(--pl-accent);
  }
  #shopify-section-{{ section.id }}
  .pl-hero-copy .pl-lede {
    max-width: 57ch;
  }
  #shopify-section-{{ section.id }}
  .pl-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 25px;
  }
  #shopify-section-{{ section.id }}
  .pl-hero-points {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    list-style: none;
    padding: 0;
    margin: 25px 0 0;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--pl-paper-2);
  }
  #shopify-section-{{ section.id }}
  .pl-hero-points li::before {
    content: '✓';
    color: #4f7d10;
    margin-right: 6px;
  }
  #shopify-section-{{ section.id }}
  .pl-hero-offers {
    position: relative;
    min-height: 330px;
    display: grid;
    align-items: end;
  }
  #shopify-section-{{ section.id }}
  .pl-hero-offer-list {
    width: 100%;
    display: grid;
    gap: 10px;
    position: relative;
    z-index: 1;
  }
  #shopify-section-{{ section.id }}
  .pl-hero-offer {
    display: grid;
    grid-template-columns: 32px 1fr auto;
    align-items: center;
    gap: 12px;
    padding: 15px 17px;
    transition: transform 0.35s var(--pl-ease);
  }
  section[id="shopify-section-{{ section.id }}"] .pl-hero-offer:hover {
    transform: translateX(-5px);
  }
  #shopify-section-{{ section.id }}
  .pl-hero-offer-index {
    color: var(--pl-paper-3);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.12em;
  }
  #shopify-section-{{ section.id }}
  .pl-hero-offer h2 {
    color: var(--pl-surface);
    font-family: Outfit
    , sans-serif;
    font-size: 15px;
    font-weight: 700;
    margin: 0 0 5px;
    text-transform: uppercase;
  }
  #shopify-section-{{ section.id }}
  .pl-hero-price {
    display: flex;
    gap: 8px;
    align-items: baseline;
  }
  #shopify-section-{{ section.id }}
  .pl-hero-price strong {
    color: var(--pl-accent);
    font-family: Outfit
    , sans-serif;
    font-size: 20px;
  }
  #shopify-section-{{ section.id }}
  .pl-hero-price s {
    color: var(--pl-paper-3);
    font-size: 11px;
  }
  #shopify-section-{{ section.id }}
  .pl-hero-discount {
    padding: 5px 8px;
    border: 1px solid rgba(201, 118, 29, 0.3);
    border-radius: 99px;
    color: #4f7d10;
    background: rgba(201, 118, 29, 0.12);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  #shopify-section-{{ section.id }}
  .pl-hero-orb {
    position: absolute;
    top: -40px;
    right: 0;
    width: min(100%, 380px);
    color: #00706a;
    opacity: .9;
  }
  #shopify-section-{{ section.id }}
  .pl-hero-orb svg {
    width: 100%;
    height: auto;
  }
  #shopify-section-{{ section.id }}
  .pl-hero-water {
    position: absolute;
    inset: auto -10% -62px;
    height: 150px;
    opacity: .38;
    pointer-events: none;
  }
  #shopify-section-{{ section.id }}
  .pl-hero-water span {
    position: absolute;
    width: 58%;
    height: 105px;
    border-radius: 50%;
    border: 1px solid rgba(0, 112, 106, 0.16);
    animation: pl-hero-wave 9s ease-in-out infinite;
  }
  section[id="shopify-section-{{ section.id }}"] .pl-hero-water span:nth-child(1) {
    left: -5%;
    bottom: 0;
  }
  section[id="shopify-section-{{ section.id }}"] .pl-hero-water span:nth-child(2) {
    left: 27%;
    bottom: 23px;
    animation-delay: -3s;
  }
  section[id="shopify-section-{{ section.id }}"] .pl-hero-water span:nth-child(3) {
    right: -12%;
    bottom: -10px;
    animation-delay: -6s;
  }
  @keyframes pl-hero-wave {
    50% {
      transform: translateY(-15px) rotate(2deg);
    }
  }
  @media (max-width: 760px) {
    #shopify-section-{{ section.id }} .pl-hero {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    #shopify-section-{{ section.id }}
    .pl-hero-offers {
      min-height: 0;
    }
    #shopify-section-{{ section.id }}
    .pl-hero-orb {
      width: 230px;
      top: -60px;
    }
    #shopify-section-{{ section.id }}
    .pl-hero-offer {
      padding: 13px;
    }
    #shopify-section-{{ section.id }}
    .pl-hero-points {
      display: grid;
      gap: 7px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .pl-hero-water span {
      animation: none;
    }
    #shopify-section-{{ section.id }}
    .pl-hero-offer {
      transition: none;
    }
  }
</style>

<script>
  (function() {
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var items = document.querySelectorAll('#shopify-section-{{ section.id }} .pl-rv');
    if ('IntersectionObserver' in window && !reduce) {
      var io = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('in');
            io.unobserve(entry.target);
          }
        });
      }, { rootMargin: '0px 0px -12% 0px', threshold: 0.12 });
      items.forEach(function(item) { io.observe(item); });
    } else {
      items.forEach(function(item) { item.classList.add('in'); });
    }
  })();
</script>

{% schema %}
  {
    "name": "Purelane Hero",
    "tag": "section",
    "class": "pl-section",
    "settings": [
      {
        "type": "richtext",
        "id": "heading",
        "label": "Heading",
        "default": "<p>Clean<br>That <em>Lasts</em></p>"
      },
      {
        "type": "textarea",
        "id": "subheading",
        "label": "Subheading",
        "default": "Homecare that works on the toughest grime, made from plants. Kind to your home, your family and the world outside it."
      },
      {
        "type": "text",
        "id": "primary_text",
        "label": "Primary button text",
        "default": "Shop now"
      },
      {
        "type": "url",
        "id": "primary_link",
        "label": "Primary button link"
      },
      {
        "type": "text",
        "id": "secondary_text",
        "label": "Secondary button text",
        "default": "How it works"
      },
      {
        "type": "url",
        "id": "secondary_link",
        "label": "Secondary button link"
      },
      {
        "type": "select",
        "id": "background_style",
        "label": "Background style",
        "options": [
          {
            "value": "scene1",
            "label": "Lavender"
          },
          {
            "value": "scene2",
            "label": "Sage"
          }
        ],
        "default": "scene1"
      },
      {
        "type": "checkbox",
        "id": "show_water_animation",
        "label": "Show water animation",
        "default": true
      }
    ],
    "blocks": [
      {
        "type": "slide",
        "name": "Offer slide",
        "limit": 3,
        "settings": [
          {
            "type": "text",
            "id": "label",
            "label": "Offer label",
            "default": "Single bottle"
          },
          {
            "type": "text",
            "id": "price",
            "label": "Price",
            "default": "₹200"
          },
          {
            "type": "text",
            "id": "compare_price",
            "label": "Compare-at price",
            "default": "₹299"
          },
          {
            "type": "text",
            "id": "discount_text",
            "label": "Discount text",
            "default": "Save"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Purelane Hero",
        "blocks": [
          {
            "type": "slide"
          },
          {
            "type": "slide"
          },
          {
            "type": "slide"
          }
        ]
      }
    ]
  }
{% endschema %}