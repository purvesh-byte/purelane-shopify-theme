{% comment %}
  Purelane Product Grid
  Matches prototype #shop section.
  Changes from prototype:
  - Uses real Shopify collection data
  - Product cards rendered via reusable snippet
  - Grid responsive and editable
  - Empty state handled gracefully
{% endcomment %}

{%- liquid
  assign collection = section.settings.collection
  assign heading = section.settings.heading | default: 'Loved by 30,000 homes'
  assign kicker = section.settings.kicker | default: 'Bestsellers'
  assign products_to_show = section.settings.products_to_show | default: 8
  assign columns_desktop = section.settings.columns_desktop | default: 4
-%}

<section
  id="shopify-section-{{ section.id }}"
  class="pl-section pl-product-grid-sec"
  data-section-id="{{ section.id }}"
>
  <div class="pl-wrap">
    <div class="pl-panel-head pl-rv">
      <span class="pl-kicker">{{ kicker | escape }}</span>
      <h2 class="pl-d2" style="margin-top:12px">{{ heading | escape }}</h2>
      <div class="pl-rule">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
        <i></i>
      </div>
    </div>

    {%- if collection != blank and collection.products.size > 0 -%}
      <div
        class="pl-shelf"
        style="--grid-cols: {{ columns_desktop }};"
        role="list"
        aria-label="Products"
      >
        {%- for product in collection.products limit: products_to_show -%}
          <div class="pl-shelf-item pl-rv" role="listitem" style="transition-delay: {{ forloop.index0 | times: 0.09 }}s;">
            {%- render 'purelane-product-card',
              product: product,
              section_id: section.id,
              index: forloop.index
            -%}
          </div>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="pl-grid-empty pl-rv">
        <p class="pl-body-s">No products found. Select a collection with products in the section settings.</p>
      </div>
    {%- endif -%}
  </div>
</section>

<style>
#shopify-section-{{ section.id }} .pl-product-grid-sec { padding: 34px 0; }
#shopify-section-{{ section.id }} .pl-shelf {
  display: grid;
  gap: 14px;
  grid-template-columns: repeat(2, 1fr);
}
@media (min-width: 860px) {
  #shopify-section-{{ section.id }} .pl-shelf {
    grid-template-columns: repeat(var(--grid-cols, 4), 1fr);
  }
}
#shopify-section-{{ section.id }} .pl-shelf-item { height: 100%; }
#shopify-section-{{ section.id }} .pl-grid-empty {
  text-align: center; padding: 60px 20px;
  background: linear-gradient(158deg, rgba(255,255,255,0.66), rgba(236,230,247,0.44));
  border-radius: var(--pl-radius); border: 1px solid rgba(75, 58, 143, 0.13);
}
</style>

<script>
(function() {
  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var items = document.querySelectorAll('#shopify-section-{{ section.id }} .pl-rv');
  if ('IntersectionObserver' in window && !reduce) {
    var io = new IntersectionObserver(function(es) {
      es.forEach(function(e) {
        if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      });
    }, { rootMargin: '0px 0px -12% 0px', threshold: 0.12 });
    items.forEach(function(el) { io.observe(el); });
  } else {
    items.forEach(function(el) { el.classList.add('in'); });
  }
})();
</script>

{% schema %}
{
  "name": "Purelane Product Grid",
  "tag": "section",
  "class": "pl-section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Bestsellers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by 30,000 homes"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 12,
      "step": 1,
      "label": "Products to show",
      "default": 8
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columns on desktop",
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Purelane Product Grid"
    }
  ]
}
{% endschema %}