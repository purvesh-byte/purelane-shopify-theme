{% comment %}
  Purelane Best-Selling Combos
  Matches prototype #combos horizontal rail.
  Changes from prototype:
  - Combos are editable blocks, not hardcoded
  - Products pulled from Shopify
  - Prices editable (since combos may not be real products)
  - Accessible horizontal scroll with keyboard support
{% endcomment %}

{%- liquid
  assign heading = section.settings.heading | default: 'Best selling combos'
  assign kicker = section.settings.kicker | default: 'Pre-built to save you money'
  assign subheading = section.settings.subheading | default: 'Swipe through the boxes people order most. Each one is already priced below buying the same products on their own.'
-%}

<section
  id="shopify-section-{{ section.id }}"
  class="pl-section pl-combos-sec"
  data-section-id="{{ section.id }}">
  <div class="pl-wrap">
    <div class="pl-panel-head pl-rv">
      <span class="pl-kicker">{{ kicker | escape }}</span>
      <h2 class="pl-d2" style="margin-top:12px">{{ heading | escape }}</h2>
      <div class="pl-rule">
        <i></i>
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z" /><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z" /></svg>
        <i></i>
      </div>
      <p class="pl-lede" style="margin:14px auto 0">{{ subheading | escape }}</p>
    </div>

    {%- if section.blocks.size > 0 -%}
      <div
        class="pl-comborail pl-rv"
        role="region"
        aria-label="Bundle combos"
        tabindex="0">
        {%- for block in section.blocks -%}
          {%- liquid
            assign products = block.settings.product_list
            assign is_hero = block.settings.highlight
            assign card_class = 'pl-glass pl-combo'
            if is_hero
              assign card_class = card_class | append: ' pl-combo-hero'
            endif
          -%}
          <article class="{{ card_class }}" {{ block.shopify_attributes }}>
            <div class="pl-combo-tray">
              {%- if block.settings.save_text != blank -%}
                <span class="pl-combo-save">{{ block.settings.save_text | escape }}</span>
              {%- endif -%}
              {%- if block.settings.flag != blank -%}
                <span class="pl-combo-flag">{{ block.settings.flag | escape }}</span>
              {%- endif -%}
              <div class="pl-combo-stack">
                {%- for prod in products -%}
                  <span class="pl-combo-it">
                    {%- if prod.featured_image -%}
                      <img
                        src="{{ prod.featured_image | image_url: width: 200 }}"
                        alt="{{ prod.title | escape }}"
                        loading="lazy"
                        width="100"
                        height="120"
                        class="pl-combo-img">
                    {%- else -%}
                      <span class="pl-combo-tile" aria-label="{{ prod.title | escape }}">
                        <svg
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.6"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          aria-hidden="true"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z" /><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z" /></svg>
                      </span>
                    {%- endif -%}
                    {% liquid
                      assign label_key = 'product_label_' | append: forloop.index
                      assign product_label = block.settings[label_key]
                    %}

                    <span>{{ product_label | default: prod.title | truncatewords: 3 | escape }}</span>
                  </span>
                  {%- unless forloop.last -%}
                    <span class="pl-combo-plus" aria-hidden="true">+</span>
                  {%- endunless -%}
                {%- endfor -%}
              </div>
            </div>
            <div class="pl-combo-body">
              <h3>{{ block.settings.title | escape }}</h3>
              <div class="pl-combo-cnt">{{ products.size }} products</div>
              <p class="pl-combo-inc">{{ block.settings.description | escape }}</p>
              <div class="pl-combo-prow">
                <strong>{{ block.settings.price | escape }}</strong>
                <s>{{ block.settings.compare_price | escape }}</s>
                <em>{{ block.settings.discount_text | escape }}</em>
              </div>
              <div class="pl-combo-fine">{{ block.settings.fine_print | escape }}</div>
              <a class="pl-btn {% if is_hero %}pl-btn-primary{% else %}pl-btn-ghost{% endif %}" href="{{ block.settings.cta_link | default: '#bundles' }}">
                {{ block.settings.cta_text | default: 'Shop bundle' }}
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6" /></svg>
              </a>
            </div>
          </article>
        {%- endfor -%}
      </div>

      <div class="pl-swipecue" aria-hidden="true">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6" /></svg>
        Swipe for more combos
      </div>
      <p class="pl-railnote">Tapping "Shop bundle" opens the bundle picker with these products already added. You can still swap anything before you pay.</p>
    {%- else -%}
      <div class="pl-combos-empty pl-rv">
        <p class="pl-body-s">Add combo blocks to display bundles.</p>
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} .pl-combos-sec {
    padding: 34px 0;
  }
  #shopify-section-{{ section.id }}
  .pl-comborail {
    display: flex;
    gap: 14px;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    margin: 0 -18px;
    padding: 4px 18px 14px;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  #shopify-section-{{ section.id }}
  .pl-comborail::-webkit-scrollbar {
    display: none;
  }
  #shopify-section-{{ section.id }}.pl-comborail:focus {
    outline: 2px solid var(--pl-accent);
    outline-offset: -2px;
    border-radius: 8px;
  }

  #shopify-section-{{ section.id }}
  .pl-combo {
    flex: 0 0 302px;
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    padding: 0;
    transition: 0.4s var(--pl-ease);
  }
  #shopify-section-{{ section.id }}.pl-combo:hover {
    transform: translateY(-5px);
  }
  #shopify-section-{{ section.id }}
  .pl-combo-hero {
    border-color: rgba(201, 118, 29, 0.46);
    box-shadow: 0 22px 54px rgba(58, 44, 112, 0.14)
    , 0 0 0 1px rgba(201, 118, 29, 0.24), var(--pl-g-inset);
  }

  #shopify-section-{{ section.id }}
  .pl-combo-tray {
    padding: 14px 14px 13px;
    border-bottom: 1px solid rgba(75, 58, 143, 0.12);
    position: relative;
    background: linear-gradient(162deg, rgba(255,255,255,0.56), rgba(236,230,247,0.34));
  }
  #shopify-section-{{ section.id }}
  .pl-combo-save {
    display: inline-block;
    font-size: 9.5px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 5px 11px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.84);
    border: 1px solid rgba(201, 118, 29, 0.34);
    color: #4f7d10;
    margin-bottom: 13px;
  }
  #shopify-section-{{ section.id }}
  .pl-combo-flag {
    position: absolute;
    top: 14px;
    right: 14px;
    font-size: 8.6px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 5px 10px;
    border-radius: 999px;
    background: linear-gradient(135deg, #00706a, #004b46);
    color: #f4fdf6;
  }

  #shopify-section-{{ section.id }}
  .pl-combo-stack {
    display: flex;
    align-items: flex-end;
    gap: 3px;
  }
  #shopify-section-{{ section.id }}
  .pl-combo-it {
    flex: 1 1 0;
    min-width: 0;
    text-align: center;
  }
  #shopify-section-{{ section.id }}
  .pl-combo-it img {
    height: 66px;
    margin: 0 auto 8px;
    object-fit: contain;
    filter: drop-shadow(0 5px 8px rgba(0,74,66,0.13));
  }
  #shopify-section-{{ section.id }}
  .pl-combo-it span {
    display: block;
    font-size: 8.6px;
    line-height: 1.32;
    color: var(--pl-paper-2);
    font-weight: 600;
  }
  #shopify-section-{{ section.id }}
  .pl-combo-tile {
    height: 66px;
    width: 44px;
    margin: 0 auto 8px;
    display: grid;
    place-items: center;
    border-radius: 9px;
    background: rgba(255, 255, 255, 0.5);
    border: 1px dashed rgba(75, 58, 143, 0.26);
    color: #4f7d10;
  }
  #shopify-section-{{ section.id }}
  .pl-combo-tile svg {
    width: 17px;
    height: 17px;
  }
  #shopify-section-{{ section.id }}
  .pl-combo-plus {
    flex: 0 0 9px;
    color: var(--pl-accent);
    font-weight: 800;
    font-size: 12px;
    padding-bottom: 30px;
    text-align: center;
  }

  #shopify-section-{{ section.id }}
  .pl-combo-body {
    padding: 15px 16px 18px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  #shopify-section-{{ section.id }}
  .pl-combo-body h3 {
    font-family: 'Outfit'
    , sans-serif;
    font-size: 16px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: -0.005em;
    line-height: 1.1;
    color: var(--pl-surface);
  }
  #shopify-section-{{ section.id }}
  .pl-combo-cnt {
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--pl-paper-3);
    margin-top: 6px;
  }
  #shopify-section-{{ section.id }}
  .pl-combo-inc {
    font-size: 12.4px;
    color: var(--pl-paper-2);
    line-height: 1.55;
    margin: 11px 0 14px;
    flex: 1;
  }
  #shopify-section-{{ section.id }}
  .pl-combo-prow {
    display: flex;
    align-items: baseline;
    gap: 9px;
    flex-wrap: wrap;
    margin-bottom: 6px;
  }
  #shopify-section-{{ section.id }}
  .pl-combo-prow strong {
    font-family: 'Outfit'
    , sans-serif;
    font-size: 25px;
    font-weight: 800;
    color: var(--pl-surface);
    letter-spacing: -0.02em;
  }
  #shopify-section-{{ section.id }}
  .pl-combo-prow s {
    font-size: 13px;
    color: var(--pl-paper-3);
  }
  #shopify-section-{{ section.id }}
  .pl-combo-prow em {
    font-style: normal;
    font-size: 9.5px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 4px 9px;
    border-radius: 999px;
    background: rgba(201, 118, 29, 0.14);
    border: 1px solid rgba(201, 118, 29, 0.34);
    color: #4f7d10;
  }
  #shopify-section-{{ section.id }}
  .pl-combo-fine {
    font-size: 10.4px;
    color: var(--pl-paper-3);
    margin-bottom: 14px;
  }
  #shopify-section-{{ section.id }}
  .pl-combo .pl-btn {
    width: 100%;
    justify-content: center;
  }

  #shopify-section-{{ section.id }}
  .pl-swipecue {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--pl-paper-3);
    margin-top: 2px;
  }
  #shopify-section-{{ section.id }}
  .pl-swipecue svg {
    width: 14px;
    height: 14px;
    color: var(--pl-accent);
  }
  #shopify-section-{{ section.id }}
  .pl-railnote {
    text-align: center;
    font-size: 12px;
    color: var(--pl-paper-3);
    margin-top: 14px;
    max-width: 62ch;
    margin-left: auto;
    margin-right: auto;
  }
  #shopify-section-{{ section.id }}
  .pl-combos-empty {
    text-align: center;
    padding: 60px 20px;
    background: linear-gradient(158deg, rgba(255,255,255,0.66), rgba(236,230,247,0.44));
    border-radius: var(--pl-radius);
    border: 1px solid rgba(75, 58, 143, 0.13);
  }

  @media (max-width: 760px) {
    #shopify-section-{{ section.id }} .pl-combo {
      flex: 0 0 268px;
    }
    #shopify-section-{{ section.id }}
    .pl-combo-it img {
      height: 56px;
    }
    #shopify-section-{{ section.id }}
    .pl-combo-tile {
      height: 56px;
      width: 38px;
    }
    #shopify-section-{{ section.id }}
    .pl-comborail {
      margin: 0 -14px;
      padding: 4px 14px 12px;
    }
  }
</style>

<script>
  (function() {
  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var items = document.querySelectorAll('#shopify-section-{{ section.id }} .pl-rv');
  if ('IntersectionObserver' in window && !reduce) {
    var io = new IntersectionObserver(function(es) {
      es.forEach(function(e) {
        if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      });
    }, { rootMargin: '0px 0px -12% 0px', threshold: 0.12 });
    items.forEach(function(el) { io.observe(el); });
  } else {
    items.forEach(function(el) { el.classList.add('in'); });
  }
  })();
</script>

{% schema %}
  {
    "name": "Purelane Combos",
    "tag": "section",
    "class": "pl-section",
    "settings": [
      {
        "type": "text",
        "id": "kicker",
        "label": "Kicker",
        "default": "Pre-built to save you money"
      },
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "Best selling combos"
      },
      {
        "type": "textarea",
        "id": "subheading",
        "label": "Subheading",
        "default": "Swipe through the boxes people order most. Each one is already priced below buying the same products on their own."
      }
    ],
    "blocks": [
      {
        "type": "combo",
        "name": "Combo",
        "settings": [
          {
            "type": "text",
            "id": "title",
            "label": "Combo name",
            "default": "Kitchen essentials"
          },
          {
            "type": "product_list",
            "id": "product_list",
            "label": "Products in combo",
            "limit": 3
          },
          {
            "type": "text",
            "id": "product_label_1",
            "label": "Product 1 short label"
          },
          {
            "type": "text",
            "id": "product_label_2",
            "label": "Product 2 short label"
          },
          {
            "type": "text",
            "id": "product_label_3",
            "label": "Product 3 short label"
          },
          {
            "type": "textarea",
            "id": "description",
            "label": "Description",
            "default": "Everything for a sparkling kitchen, no need to pick separately."
          },
          {
            "type": "text",
            "id": "save_text",
            "label": "Save badge text",
            "default": "You save ₹398"
          },
          {
            "type": "text",
            "id": "flag",
            "label": "Flag text (optional)",
            "info": "e.g. Most popular, Best value"
          },
          {
            "type": "text",
            "id": "price",
            "label": "Price",
            "default": "₹499"
          },
          {
            "type": "text",
            "id": "compare_price",
            "label": "Compare-at price",
            "default": "₹897"
          },
          {
            "type": "text",
            "id": "discount_text",
            "label": "Discount text",
            "default": "Save ₹398"
          },
          {
            "type": "text",
            "id": "fine_print",
            "label": "Fine print",
            "default": "Inclusive of all taxes · COD available"
          },
          {
            "type": "text",
            "id": "cta_text",
            "label": "CTA text",
            "default": "Shop bundle"
          },
          {
            "type": "url",
            "id": "cta_link",
            "label": "CTA link"
          },
          {
            "type": "checkbox",
            "id": "highlight",
            "label": "Highlight as hero combo",
            "default": false,
            "info": "Uses primary button style and accent border"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Purelane Combos",
        "blocks": [
          {
            "type": "combo"
          },
          {
            "type": "combo"
          },
          {
            "type": "combo"
          }
        ]
      }
    ]
  }
{% endschema %}